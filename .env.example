# ─────────────────────────────────────────────────────────────────────────────
# Foodly — configuración de la app móvil
# Copia este archivo a .env y reinicia Expo con caché limpia: npx expo start -c
# (las variables EXPO_PUBLIC_* se incluyen al compilar el bundle).
# ─────────────────────────────────────────────────────────────────────────────

# URL ÚNICA del gateway (Kong, puerto 8000). Enruta /iam, /radar y /messaging.
#   Emulador de Android → http://10.0.2.2:8000
#   Celular con Expo Go → http://<IP de la PC en la red local>:8000   (ej. http://192.168.1.50:8000)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# ── ESCENARIO A (por defecto): demo con todo simulado ───────────────────────
# DEMO_MODE=true fuerza TODOS los mocks (ignora las banderas MOCK_*) y fija la
# ubicación en Miraflores.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_MOCK_AUTH=false
EXPO_PUBLIC_MOCK_RADAR=true
EXPO_PUBLIC_MOCK_BUSINESS=true
EXPO_PUBLIC_MOCK_COMMUNITY=true
EXPO_PUBLIC_MOCK_RESERVATION=true
EXPO_PUBLIC_MOCK_MESSAGING=true

# ── ESCENARIO B: IAM + Radar + Messaging (Lía) contra el backend real ──────
# Para usar el radar real hay que poner EXPO_PUBLIC_DEMO_MODE=false Y
# EXPO_PUBLIC_MOCK_RADAR=false (con DEMO_MODE=true siguen los mocks).
# Reemplaza el bloque anterior por este (y ajusta API_BASE_URL según el dispositivo):
#
#   EXPO_PUBLIC_DEMO_MODE=false
#   EXPO_PUBLIC_MOCK_AUTH=false
#   EXPO_PUBLIC_MOCK_RADAR=false
#   EXPO_PUBLIC_MOCK_MESSAGING=false
#   EXPO_PUBLIC_MOCK_BUSINESS=true       # Business aún no tiene API
#   EXPO_PUBLIC_MOCK_COMMUNITY=true
#   EXPO_PUBLIC_MOCK_RESERVATION=true
#
# Radar devuelve ids; las tarjetas se arman con el catálogo demo (h1…h10), así que
# radar-service debe tener cargados esos ids (scripts/seed-demo-app).
# Guía completa: docs/PRUEBA_E2E.md
